<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>StageValidate</AssemblyName>
    <RootNamespace>StageValidate</RootNamespace>
    <NoWarn>CS0649;CS0414</NoWarn>
  </PropertyGroup>

  <!--
    리포의 실제 소스를 링크한다. 복사본을 두면 검증하는 코드와 게임이 쓰는 코드가
    갈라져서 검증 의미가 없어진다. UnityEngine 의존은 UnityStubs.cs가 대신한다.
  -->
  <ItemGroup>
    <Compile Include="..\..\Assets\Scripts\Map code\RoomType.cs"       Link="src\RoomType.cs" />
    <Compile Include="..\..\Assets\Scripts\Map code\MapNode.cs"        Link="src\MapNode.cs" />
    <Compile Include="..\..\Assets\Scripts\Map code\StageMap.cs"       Link="src\StageMap.cs" />
    <Compile Include="..\..\Assets\Scripts\Map code\StageGenerator.cs" Link="src\StageGenerator.cs" />
    <Compile Include="..\..\Assets\Scripts\Data code\RoomData.cs"      Link="src\RoomData.cs" />
    <Compile Include="..\..\Assets\Scripts\Data code\StageData.cs"     Link="src\StageData.cs" />
    <Compile Include="..\..\Assets\Scripts\Data code\EnemyData.cs"     Link="src\EnemyData.cs" />
    <Compile Include="..\..\Assets\Scripts\Enemy code\EnemyStats.cs"   Link="src\EnemyStats.cs" />
  </ItemGroup>

</Project>
